# Cloudflare Turnstile CAPTCHA Keys
# 1. Clave del sitio (Cliente / Frontend)
# Generada en el panel de Cloudflare Turnstile (ejemplo: 0x4AAAAAA...)
# Por defecto usa '1x00000000000000000000AA' (clave de pruebas oficial que siempre aprueba)
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# 2. Clave secreta (Servidor / Backend - Cloudflare Pages / Workers)
# Generada en el panel de Cloudflare Turnstile (ejemplo: 0x4AAAAAA...)
# Configúrala en Cloudflare Dashboard > Settings > Variables o en archivo .env local
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x00000000000000000000AA
